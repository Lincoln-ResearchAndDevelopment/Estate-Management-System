APP_NAME="PAHE Estate Management"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pahe_estate
DB_USERNAME=pahe
DB_PASSWORD=

# Sanctum SPA cookie authentication. The front end and API must share a parent domain in production
# (e.g. app.example.ng and api.example.ng with SESSION_DOMAIN=.example.ng).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_DOMAIN=localhost
SESSION_SECURE_COOKIE=false
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@pahe.example.ng"
MAIL_FROM_NAME="${APP_NAME}"

# Cloudflare Turnstile (public enquiries). Leave empty in local development to skip verification.
TURNSTILE_SECRET_KEY=

ESTATE_NAME="Post Army Housing Estates"
ESTATE_SHORT_NAME=PAHE
ESTATE_CODE_PREFIX=PAHE
