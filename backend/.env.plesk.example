# ---------------------------------------------------------------------------------------------
# Settings for a TEST install on shared Plesk hosting (API and web app both on Plesk subdomains).
# Copy to .env, replace every CHANGE_ME and every "yourdomain.com", then run: php artisan key:generate
# Never commit the real .env. Guide: documentation/plesk-shared-hosting.md
# ---------------------------------------------------------------------------------------------
APP_NAME="PAHE Estate Management"
# "staging" allows the clearly-marked TEST data and the Paystack test checkout. Use "production" for real use.
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Africa/Lagos

# The address of the web app subdomain (people only ever visit this one), e.g. https://estate.yourdomain.com
APP_URL=https://estate.yourdomain.com
FRONTEND_URL=https://estate.yourdomain.com
# Links in e-mails and receipts point at the web address, which passes requests on to this API.
FORCE_APP_URL=true

LOG_CHANNEL=daily
LOG_LEVEL=warning

# From Plesk: Databases -> Add Database (host is usually localhost on shared hosting).
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=CHANGE_ME
DB_USERNAME=CHANGE_ME
DB_PASSWORD=CHANGE_ME

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
# Web subdomain host, without https:// (e.g. estate.yourdomain.com)
SANCTUM_STATEFUL_DOMAINS=estate.yourdomain.com
CORS_ALLOWED_ORIGINS=https://estate.yourdomain.com
# Requests arrive through the web app, so trust forwarded client IPs (needed for per-IP rate limits).
# Best: the server's own IP address (shown in Plesk). "*" works but lets direct callers fake their IP.
TRUSTED_PROXIES=CHANGE_ME

# No long-running worker on shared hosting: the per-minute Scheduled Task also sends queued e-mails.
QUEUE_CONNECTION=database
QUEUE_VIA_SCHEDULER=true
CACHE_STORE=database
FILESYSTEM_DISK=local

# Your hosting's mail server (Plesk: Mail -> mail settings) or any SMTP provider.
MAIL_MAILER=smtp
MAIL_HOST=mail.yourdomain.com
# 587 = STARTTLS. For port 465 add the line MAIL_SCHEME=smtps
MAIL_PORT=587
MAIL_USERNAME=no-reply@yourdomain.com
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM_ADDRESS=no-reply@yourdomain.com
MAIL_FROM_NAME="${APP_NAME}"

ESTATE_NAME="Post Army Housing Estates"
ESTATE_SHORT_NAME=PAHE
ESTATE_CODE_PREFIX=PAHE
# Two-factor sign-in is enforced for admins/finance when true (always true in production).
MFA_ENFORCED=false
# Leave empty to use the built-in test checkout; add a Paystack test key (sk_test_...) to try real Paystack.
PAYSTACK_SECRET_KEY=
TURNSTILE_SECRET_KEY=
# Password for the seeded TEST accounts (e.g. resident.head@test.pahe.local).
DEMO_USER_PASSWORD=Demo@Pahe2026
