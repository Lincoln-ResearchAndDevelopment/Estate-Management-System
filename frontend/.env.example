# Laravel API base URL (browser). Must share a parent domain with this app in production for Sanctum cookies.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional: URL the Next.js server uses to reach the API (e.g. inside Docker). Defaults to NEXT_PUBLIC_API_URL.
API_INTERNAL_URL=
# Public site URL, used for canonical links and Open Graph tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ESTATE_NAME="Post Army Housing Estates"
# Cloudflare Turnstile site key for public enquiry forms (leave empty in development).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
