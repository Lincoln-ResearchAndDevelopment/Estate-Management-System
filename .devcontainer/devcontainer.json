{
  "name": "PAHE Estate Management (live test)",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "hostRequirements": { "cpus": 4, "memory": "8gb" },
  "forwardPorts": [3000, 8025],
  "portsAttributes": {
    "3000": { "label": "PAHE web app", "onAutoForward": "openBrowser" },
    "8025": { "label": "Test mailbox (Mailpit)", "onAutoForward": "silent" }
  },
  "postCreateCommand": "./scripts/setup-env.sh && docker compose up -d --build",
  "postStartCommand": "./scripts/setup-env.sh && docker compose up -d"
}
